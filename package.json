{
  "name": "dragons-of-mugloar",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run start:dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test:e2e:ui": "playwright test -c e2e",
    "lint": "npm run lint --workspaces --if-present",
    "bot": "npm run bot -w backend --"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^10.0.7"
  }
}
